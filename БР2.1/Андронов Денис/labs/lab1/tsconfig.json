{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "outDir": "./dist",      
    "rootDir": "./src",      
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*"] 
}