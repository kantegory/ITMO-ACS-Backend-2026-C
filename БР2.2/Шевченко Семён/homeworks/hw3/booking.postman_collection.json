            ]
          }
        }
      ]
    },
    {
      "name": "8 Сортировка ресторанов price_asc",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{restaurants_url}}/restaurants?sort=price_asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код 200', () => pm.response.to.have.status(200));",
              "pm.test('Правильный порядок', () => { const xs=pm.response.json(); pm.expect(xs.length).to.be.at.least(2); pm.expect(xs.every((x,i)=>i===0 || Number(xs[i-1].avg_price) <= Number(x.avg_price))).to.eql(true); });"
            ]
          }
        }
      ]
    },
