{
  "info": {
    "name": "Бронирование столика",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Последовательный сценарий пользователя и администратора ресторана. Тестовые данные из SQL: admin@example.com / Student123. Каждый полный запуск завершает или отменяет созданные брони."
  },
  "variable": [
    {
      "key": "users_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "restaurants_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "bookings_url",
      "value": "http://localhost:3000/api"
    }
  ],
  "item": [
    {
      "name": "1 Регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Student123\",\n  \"name\": \"Семён\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код 201', () => pm.response.to.have.status(201));",
              "pm.test('Пароль скрыт', () => pm.expect(pm.response.json()).not.to.have.property('password_hash'));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('email', 'student-' + Date.now() + '@example.com');",
              "pm.collectionVariables.set('date', new Date(Date.now()+86400000).toISOString().slice(0,10));",
              "pm.collectionVariables.set('date2', new Date(Date.now()+172800000).toISOString().slice(0,10));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Вход",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Student123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код 200', () => pm.response.to.have.status(200));",
              "pm.test('Получен JWT', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Личный кабинет",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{users_url}}/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код 200', () => pm.response.to.have.status(200));",
              "pm.test('Мой email', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));",
              "pm.collectionVariables.set('user', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Изменить профиль",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{users_url}}/users/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Семён Тест\",\n  \"phone\": \"+79990000000\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код 200', () => pm.response.to.have.status(200));",
              "pm.test('Имя изменено', () => { pm.expect(pm.response.json().name).to.eql('Семён Тест'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5 Города",
