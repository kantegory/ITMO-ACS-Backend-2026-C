              "pm.collectionVariables.set('slot', pm.response.json().time_slots[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Категория меню и отзывы rating_asc",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{restaurants_url}}/restaurants/{{restaurant}}?menu_category=Горячее&reviews_sort=rating_asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код 200', () => pm.response.to.have.status(200));",
              "pm.test('Фильтр категории', () => { const menu=pm.response.json().menu; pm.expect(menu.length).to.be.above(0); pm.expect(menu.every(x=>x.category==='Горячее')).to.eql(true); });",
              "pm.test('Порядок оценок', () => { const xs=pm.response.json().reviews; pm.expect(xs.length).to.be.at.least(2); pm.expect(xs.every((x,i)=>i===0 || xs[i-1].rating <= x.rating)).to.eql(true); });",
              "pm.test('Рейтинг рассчитан по отзывам', () => { const data=pm.response.json(); pm.expect(Number(data.rating)).to.eql(data.reviews.reduce((s,x)=>s+x.rating,0)/data.reviews.length); });"
            ]
          }
        }
      ]
    },
