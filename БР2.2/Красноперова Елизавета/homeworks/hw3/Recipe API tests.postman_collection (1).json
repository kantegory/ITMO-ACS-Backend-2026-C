          "mode": "raw",
          "raw": "{\n    \"title\": \"Паста Карбонара\",\n    \"description\": \"Классический итальянский рецепт пасты карбонара с беконом и сливочным соусом\",\n    \"cooking_time_min\": 30,\n    \"difficulty\": \"medium\",\n    \"dish_type\": \"Паста\",\n    \"steps\": [\n        {\n            \"step_number\": 1,\n            \"instruction_text\": \"Сварите спагетти в подсоленной воде до состояния аль денте\"\n        },\n        {\n            \"step_number\": 2,\n            \"instruction_text\": \"Обжарьте бекон до хрустящей корочки\"\n        },\n        {\n            \"step_number\": 3,\n            \"instruction_text\": \"Смешайте яйца, сливки и тёртый пармезан\"\n        },\n        {\n            \"step_number\": 4,\n            \"instruction_text\": \"Соедините горячие спагетти с беконом и яичной смесью, быстро перемешивая\"\n        }\n    ],\n    \"ingredients\": [\n        { \"ingredient_id\": 1, \"quantity\": \"200 г\" },\n        { \"ingredient_id\": 2, \"quantity\": \"100 г\" },\n        { \"ingredient_id\": 3, \"quantity\": \"2 шт\" },\n        { \"ingredient_id\": 4, \"quantity\": \"100 мл\" }\n    ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
