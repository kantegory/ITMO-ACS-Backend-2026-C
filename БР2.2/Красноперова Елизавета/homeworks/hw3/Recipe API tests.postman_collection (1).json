    {
      "name": "SearchRecipe",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 200 — Поиск выполнен\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Ответ содержит массив рецептов\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"items\");",
              "    pm.expect(jsonData.items).to.be.an(\"array\");",
              "    pm.expect(jsonData).to.have.property(\"total\");",
              "    pm.expect(jsonData).to.have.property(\"page\");",
              "    pm.expect(jsonData).to.have.property(\"limit\");",
              "});",
              "",
              "pm.test(\"Найден созданный рецепт\", function () {",
              "    var jsonData = pm.response.json();",
              "    var titles = jsonData.items.map(function(item) { return item.title; });",
              "    pm.expect(titles).to.include(\"Паста Карбонара\");",
              "});",
              "",
              "pm.test(\"Фильтрация по сложности работает\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.items.forEach(function(item) {",
              "        pm.expect(item.difficulty).to.equal(\"medium\");",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
