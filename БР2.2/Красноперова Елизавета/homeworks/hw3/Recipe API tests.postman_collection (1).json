    {
      "name": "RecipePage",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 200 — Рецепт найден\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Содержит все необходимые поля\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"title\", \"Паста Карбонара\");",
              "    pm.expect(jsonData).to.have.property(\"description\");",
              "    pm.expect(jsonData).to.have.property(\"cooking_time_min\");",
              "    pm.expect(jsonData).to.have.property(\"difficulty\");",
              "    pm.expect(jsonData).to.have.property(\"dish_type\");",
              "    pm.expect(jsonData).to.have.property(\"steps\");",
              "    pm.expect(jsonData).to.have.property(\"ingredients\");",
              "    pm.expect(jsonData).to.have.property(\"author\");",
              "    pm.expect(jsonData).to.have.property(\"likes_count\");",
              "    pm.expect(jsonData).to.have.property(\"comments_count\");",
              "    pm.expect(jsonData).to.have.property(\"is_liked_by_me\");",
              "    pm.expect(jsonData).to.have.property(\"is_saved_by_me\");",
              "});",
              "",
              "pm.test(\"Шаги отсортированы по step_number\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.steps).to.be.an(\"array\").that.is.not.empty;",
              "    for (var i = 1; i < jsonData.steps.length; i++) {",
              "        pm.expect(jsonData.steps[i].step_number).to.be.above(jsonData.steps[i-1].step_number);",
              "    }",
              "});",
              "",
              "pm.test(\"Ингредиенты содержат название и количество\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.ingredients).to.be.an(\"array\").that.is.not.empty;",
              "    jsonData.ingredients.forEach(function(ing) {",
              "        pm.expect(ing).to.have.property(\"name\");",
              "        pm.expect(ing).to.have.property(\"quantity\");",
              "    });",
              "});",
              "",
              "pm.test(\"Автор указан верно\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.author).to.have.property(\"username\", \"chef_anna\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
