# Docker Compose environment reference.
# These values are already provided by docker-compose.yml.
USER_SERVICE_URL=http://user-service:3001
RECIPE_SERVICE_URL=http://recipe-service:3002
SOCIAL_SERVICE_URL=http://social-service:3003
DB_HOST=service-specific-db-name
DB_PORT=5432
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=recipes.events
SERVICE_TOKEN=internal-service-token
JWT_SECRET=your-secret-key-change-in-production
