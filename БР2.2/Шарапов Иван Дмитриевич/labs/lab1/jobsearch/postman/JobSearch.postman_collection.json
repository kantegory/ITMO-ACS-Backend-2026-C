{
  "info": {
    "name": "JobSearch API — сквозной сценарий",
    "description": "ДЗ3: регистрация -> вход -> список вакансий -> фильтрация -> просмотр вакансии -> отклик. С тестами.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "applicantToken", "value": "" },
    { "key": "vacancyId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Регистрация соискателя",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('статус 201', () => pm.response.code === 201 || pm.response.code === 409);",
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('token');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"qa_applicant@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"QA\",\n  \"lastName\": \"Tester\",\n  \"role\": \"applicant\"\n}"
        }
      }
    },
    {
      "name": "2. Вход",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.token).to.be.a('string');",
              "pm.collectionVariables.set('applicantToken', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"qa_applicant@example.com\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "3. Создать резюме",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('статус 201', () => pm.response.to.have.status(201));"],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{applicantToken}}" }
        ],
        "url": "{{baseUrl}}/resume",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Backend Developer\",\n  \"experienceYears\": 2,\n  \"skills\": [\"Node.js\", \"TypeScript\"]\n}"
        }
      }
    },
    {
      "name": "4. Список вакансий",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.items).to.be.an('array');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/vacancies"
      }
    },
    {
      "name": "5. Фильтрация (industry=IT, experienceLevel=middle)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.items).to.be.an('array');",
              "if (json.items.length) { pm.collectionVariables.set('vacancyId', json.items[0].id); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/vacancies?industry=IT&experienceLevel=middle",
          "host": ["{{baseUrl}}"],
          "path": ["vacancies"],
          "query": [
            { "key": "industry", "value": "IT" },
            { "key": "experienceLevel", "value": "middle" }
          ]
        }
      }
    },
    {
      "name": "6. Просмотр вакансии",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json).to.have.property('title');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/vacancies/{{vacancyId}}"
      }
    },
    {
      "name": "7. Отклик на вакансию",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('статус 201 или 409', () => pm.response.code === 201 || pm.response.code === 409);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{applicantToken}}" }
        ],
        "url": "{{baseUrl}}/vacancies/{{vacancyId}}/apply",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"coverLetter\": \"Здравствуйте! Хочу присоединиться к вашей команде.\"\n}"
        }
      }
    }
  ]
}
