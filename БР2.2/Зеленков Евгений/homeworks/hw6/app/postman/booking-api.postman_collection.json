{
  "info": {
    "_postman_id": "9f0f19e2-034f-4e98-af4f-038dbd0494e2",
    "name": "Booking API HW6 - deployment scenario",
    "description": "End-to-end deployment smoke scenario for HW6. Runs through gateway and covers auth, catalog, menu, reservation, review, PostgreSQL and RabbitMQ publish path.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{rootUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API is available', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Health status is ok', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register new user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test User\",\n  \"birthdate\": \"2001-05-06\",\n  \"phone\": \"{{generatedPhone}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = String(Date.now()).slice(-8);",
              "pm.environment.set('generatedPhone', '+799' + suffix);",
              "pm.environment.set('testPassword', 'user12345');",
              "const reservedAt = new Date(Date.now() + 36 * 60 * 60 * 1000);",
              "reservedAt.setMilliseconds(0);",
              "pm.environment.set('reservedAt', reservedAt.toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User is registered', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Registration returns bearer token and user without password', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.tokenType).to.eql('Bearer');",
              "  pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(json.user.phone).to.eql(pm.environment.get('generatedPhone'));",
              "  pm.expect(json.user.passwordHash).to.be.undefined;",
              "  pm.environment.set('userToken', json.accessToken);",
              "});"
            ]
          }
        }
      ]
    },
