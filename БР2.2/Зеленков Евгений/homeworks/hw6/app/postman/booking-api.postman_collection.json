            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"tableId\": \"{{tableId}}\",\n  \"reservedAt\": \"{{reservedAt}}\",\n  \"guestCount\": 2,\n  \"comment\": \"Postman test reservation\"\n}"
        },
        "url": "{{baseUrl}}/reservations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
