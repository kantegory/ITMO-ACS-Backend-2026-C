      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Restaurant list is returned', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('First restaurant id is saved', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.items).to.be.an('array').that.is.not.empty;",
              "  pm.expect(json.meta.total).to.be.above(0);",
              "  pm.environment.set('restaurantId', json.items[0].id);",
