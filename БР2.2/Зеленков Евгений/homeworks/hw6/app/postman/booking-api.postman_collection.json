          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Review is created after completed reservation', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Review is unverified before moderation', function () {",
              "  const json = pm.response.json();",
