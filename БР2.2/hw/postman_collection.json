          "mode": "raw",
          "raw": "{\n  \"title\": \"Омлет с сыром (Postman-тест)\",\n  \"shortDescription\": \"Быстрый завтрак за 10 минут\",\n  \"fullDescription\": \"Простой омлет с сыром на сковороде для проверки сценария.\",\n  \"difficulty\": \"easy\",\n  \"cookingTime\": 10,\n  \"categoryId\": 1,\n  \"tagIds\": [\n    1\n  ],\n  \"ingredients\": [\n    {\n      \"name\": \"Яйца\",\n      \"quantity\": \"3\",\n      \"unit\": \"шт\"\n    },\n    {\n      \"name\": \"Сыр\",\n      \"quantity\": \"50\",\n      \"unit\": \"г\"\n    }\n  ],\n  \"steps\": [\n    {\n      \"order\": 1,\n      \"description\": \"Взбить яйца\"\n    },\n    {\n      \"order\": 2,\n      \"description\": \"Вылить на сковороду и жарить 5 минут\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
