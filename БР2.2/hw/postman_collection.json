{
  "info": {
    "_postman_id": "905ccb56-9e04-4cda-9fda-0046cd26d4b3",
    "name": "Recipe Service — комплексный сценарий",
    "description": "Сквозной сценарий: регистрация → вход → создание рецепта → модерация администратором → публичный список и фильтрация → просмотр → лайк → комментарий → избранное → личный кабинет. ДЗ3, этап 4 проекта Recipe Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Регистрация пользователя",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rand = Date.now();",
              "pm.collectionVariables.set('testUsername', 'user' + rand);",
              "pm.collectionVariables.set('testEmail', 'user' + rand + '@example.com');",
              "pm.collectionVariables.set('testPassword', 'Password123');"
            ],
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('Пользователь создан с ролью user', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.expect(json.username).to.eql(pm.collectionVariables.get('testUsername'));",
              "    pm.expect(json.role).to.eql('user');",
              "});"
            ],
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"firstName\": \"Тест\",\n  \"lastName\": \"Тестов\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
